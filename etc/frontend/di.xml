<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Checks the posted date and time and puts them on the quote before the order is placed. -->
    <type name="Zero\Checkout\Controller\Checkout\Placeorder">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="zero_delivery_date" xsi:type="object">Zero\DeliveryDate\Model\PlaceOrder\DeliveryDate</item>
            </argument>
        </arguments>
    </type>
    <!-- The order e-mail's items block ends with the delivery date (layout/sales_email_order_items.xml). -->
    <type name="Magento\Sales\Block\Order\Email\Items">
        <plugin name="zero_delivery_date_email" type="Zero\DeliveryDate\Plugin\Email\ItemsDeliveryDate"/>
    </type>
</config>
